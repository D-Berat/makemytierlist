<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="489.0" prefWidth="551.0" spacing="15.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sae_tierlist.controller.DialogNouvelItemController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="dialog-titre" stylesheets="@style.css" text="Ajouter un item" />
        <Label styleClass="dialog-label" stylesheets="@style.css" text="Type d'item" />
        <HBox spacing="10.0">
            <children>
                <Button fx:id="boutonTypeTexte" maxWidth="1.7976931348623157E308" onAction="#onChoisirTexte" styleClass="bouton-principal" stylesheets="@style.css" text="Texte" HBox.hgrow="ALWAYS" />
                <Button fx:id="boutonTypeImage" maxWidth="1.7976931348623157E308" onAction="#onChoisirImage" styleClass="bouton-secondaire" stylesheets="@style.css" text="Image" HBox.hgrow="ALWAYS" />
                <Button fx:id="boutonTypeAPI" mnemonicParsing="false" onAction="#onChoisirAPI" prefHeight="32.0" prefWidth="118.0" styleClass="bouton-secondaire" stylesheets="@style.css" text="API" />
            </children>
        </HBox>

        <VBox fx:id="zoneTexte" spacing="8.0">
            <children>
                <Label styleClass="dialog-label" stylesheets="@style.css" text="Texte de l'item" />
                <TextField fx:id="champTexte" promptText="Ex: Mario, Zelda..." stylesheets="@style.css" />
            </children>
        </VBox>

        <VBox fx:id="zoneImage" spacing="8.0">
            <children>
                <Label styleClass="dialog-label" stylesheets="@style.css" text="Image sélectionnée" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onChoisirFichier" styleClass="bouton-secondaire" stylesheets="@style.css" text="Parcourir..." />
                        <Label fx:id="labelCheminImage" styleClass="dialog-label" stylesheets="@style.css" text="Aucune image" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <VBox fx:id="zoneAPI" spacing="8.0" VBox.vgrow="ALWAYS">
            <children>
                <Label styleClass="dialog-label" stylesheets="@style.css" text="Rechercher un jeu">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <HBox>
                    <children>
                        <TextField fx:id="champRechercheAPI" prefHeight="25.0" promptText="Ex: Dragon quest, Rayman..." HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets top="4.0" />
                            </HBox.margin>
                        </TextField>
                        <Region prefHeight="26.0" prefWidth="21.0" />
                        <Button mnemonicParsing="false" onAction="#onRechercherAPI" styleClass="bouton-secondaire" stylesheets="@style.css" text="Rechercher" />
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="imagesTrouve" hgap="8.0" vgap="8.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="boutonAnnuler" onAction="#onAnnuler" styleClass="bouton-secondaire" stylesheets="@style.css" text="Annuler" />
                <Button fx:id="boutonValider" onAction="#onValider" styleClass="bouton-principal" stylesheets="@style.css" text="Ajouter" />
            </children>
        </HBox>
    </children>
</VBox>
