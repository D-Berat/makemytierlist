<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0"
            prefWidth="1100.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sae_tierlist.controller.TierListController">
    <top>
        <HBox prefHeight="81.0" prefWidth="707.0" styleClass="top-bar" stylesheets="@style.css"
              BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="boutonRetour" mnemonicParsing="false" onAction="#onRetour" prefHeight="44.0"
                        prefWidth="117.0" styleClass="bouton-secondaire" stylesheets="@style.css" text="← Retour">
                    <HBox.margin>
                        <Insets left="10.0" top="5.0"/>
                    </HBox.margin>
                </Button>
                <Region prefHeight="37.0" prefWidth="98.0"/>
                <Button mnemonicParsing="false" onAction="#onChangerTailleItems" prefHeight="44.0" prefWidth="117.0"
                        styleClass="bouton-secondaire" stylesheets="@style.css" text="Taille items">
                    <HBox.margin>
                        <Insets right="10.0" top="5.0"/>
                    </HBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onReinitialiser" prefHeight="44.0" prefWidth="117.0"
                        styleClass="bouton-danger" stylesheets="@style.css" text="Réinitialiser">
                    <HBox.margin>
                        <Insets top="5.0"/>
                    </HBox.margin>
                </Button>
                <Region prefHeight="37.0" prefWidth="79.0" HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelNomTierList" styleClass="tierlist-title" stylesheets="@style.css" text="Label">
                    <HBox.margin>
                        <Insets top="10.0"/>
                    </HBox.margin>
                </Label>
                <Region prefHeight="56.0" prefWidth="81.0"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox prefHeight="524.0" prefWidth="1100.0" BorderPane.alignment="CENTER">
            <children>
                <ScrollPane fitToWidth="true" maxHeight="-Infinity" prefHeight="356.0" prefWidth="1100.0">
                    <content>
                        <VBox fx:id="containerTiers" prefHeight="346.0" prefWidth="1085.0"/>
                    </content>
                </ScrollPane>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="boutonAjouterTier" mnemonicParsing="false" onAction="#onAjouterTier"
                                prefHeight="67.0" prefWidth="173.0" styleClass="bouton-principal"
                                stylesheets="@style.css" text="Ajouter un tier">
                            <HBox.margin>
                                <Insets left="10.0" top="5.0"/>
                            </HBox.margin>
                        </Button>
                        <Region prefHeight="40.0" prefWidth="23.0"/>
                        <Button mnemonicParsing="false" onAction="#onAjouterItem" prefHeight="67.0" prefWidth="173.0"
                                styleClass="bouton-ajout" stylesheets="@style.css" text="Ajouter un item">
                            <HBox.margin>
                                <Insets top="5.0"/>
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
    <bottom>
        <VBox prefHeight="229.0" prefWidth="1100.0" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="19.0" prefWidth="60.0" styleClass="label-section" stylesheets="@style.css"
                       text="À classer">
                    <VBox.margin>
                        <Insets left="5.0"/>
                    </VBox.margin>
                </Label>
                <ScrollPane hbarPolicy="ALWAYS" prefHeight="200.0" prefWidth="200.0">
                    <content>
                        <FlowPane fx:id="containerAClasser" prefHeight="188.0" prefWidth="1100.0"
                                  styleClass="zone-aclasser" stylesheets="@style.css"/>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </bottom>
</BorderPane>
