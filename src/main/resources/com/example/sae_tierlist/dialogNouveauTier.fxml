<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="350.0" spacing="15.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sae_tierlist.controller.DialogNouveauTierController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="dialog-titre" stylesheets="@style.css" text="Ajouter un nouveau tier" />

        <Label styleClass="dialog-label" stylesheets="@style.css" text="Nom du tier" />
        <TextField fx:id="champNom" promptText="Ex: S, A, B..." />

        <Label styleClass="dialog-label" stylesheets="@style.css" text="Couleur" />
        <HBox fx:id="paletteCouleurs" spacing="8.0" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="boutonAnnuler" onAction="#onAnnuler" stylesheets="@style.css" text="Annuler">
               <styleClass>
                  <String fx:value="bouton-secondaire" />
                  <String fx:value="bouton-action" />
               </styleClass></Button>
                <Button fx:id="boutonValider" onAction="#onValider" styleClass="bouton-principal" stylesheets="@style.css" text="Créer" />
            </children>
        </HBox>
    </children>
</VBox>
